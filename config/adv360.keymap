#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Mod-morph behaviors for custom top row
        // Number without shift, symbol with shift
        td0: td0 {
            compatible = "zmk,behavior-mod-morph";
            label = "TILDE_DOLLAR";
            #binding-cells = <0>;
            bindings = <&kp TILDE>, <&kp DLLR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td1: td1 {
            compatible = "zmk,behavior-mod-morph";
            label = "ONE_EXCL";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td2: td2 {
            compatible = "zmk,behavior-mod-morph";
            label = "TWO_LBKT";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td3: td3 {
            compatible = "zmk,behavior-mod-morph";
            label = "THREE_LBRC";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp LBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td4: td4 {
            compatible = "zmk,behavior-mod-morph";
            label = "FOUR_LPAR";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp LPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td5: td5 {
            compatible = "zmk,behavior-mod-morph";
            label = "FIVE_AMPS";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp AMPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td6: td6 {
            compatible = "zmk,behavior-mod-morph";
            label = "SIX_EQUAL";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td7: td7 {
            compatible = "zmk,behavior-mod-morph";
            label = "SEVEN_PLUS";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp PLUS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td8: td8 {
            compatible = "zmk,behavior-mod-morph";
            label = "EIGHT_RPAR";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td9: td9 {
            compatible = "zmk,behavior-mod-morph";
            label = "NINE_RBRC";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td10: td10 {
            compatible = "zmk,behavior-mod-morph";
            label = "ZERO_RBKT";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td11: td11 {
            compatible = "zmk,behavior-mod-morph";
            label = "PRCNT_STAR";
            #binding-cells = <0>;
            bindings = <&kp PRCNT>, <&kp STAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td12: td12 {
            compatible = "zmk,behavior-mod-morph";
            label = "GRAVE_PIPE";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td13: td13 {
            compatible = "zmk,behavior-mod-morph";
            label = "HASH_CARET";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&td0       &td1       &td2      &td3      &td4       &td5    &td6                                                                &mo 3      &td7    &td8    &td9       &td10     &td11     &td12
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                               &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp PRINTSCREEN      &kp PAGE_UP    &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME             &kp PAGE_DOWN                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp MINUS  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp LEFT_ALT         &kp LGUI       &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp AT    &td13     &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&tog 4  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Trad";
            bindings = <
&kp GRAVE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &kp N6                                                   &mo 3      &kp N7  &kp N8  &kp N9     &kp N0     &kp MINUS  &kp EQUAL
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O      &kp P      &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp PRINTSCREEN      &kp PAGE_UP    &kp RCTRL  &none   &kp H   &kp J   &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME             &kp PAGE_DOWN                     &kp N   &kp M   &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&mo 2      &kp LBKT   &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp LEFT_ALT         &kp LGUI       &kp ENTER  &kp SPACE       &kp UP  &kp DOWN   &kp RBKT   &kp BSLH   &mo 2
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
